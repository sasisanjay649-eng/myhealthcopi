# Database Configuration (PostgreSQL by default, falls back smoothly to SQLite if unreachable)
DATABASE_URL=sqlite:///./vitamind.db

# Security & Authentication
SECRET_KEY=vitamind_ai_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# Real AI LLM Model Configuration
# Supported providers: 'openai', 'gemini', 'groq', 'ollama'
# ==============================================================================
AI_PROVIDER=openai

# Model selection (e.g. 'gpt-4o-mini', 'gpt-4o', 'gemini-2.0-flash', 'llama-3.3-70b-versatile')
AI_MODEL=gpt-4o-mini

# Model sampling temperature (0.0 = deterministic clinical accuracy, 1.0 = creative)
AI_TEMPERATURE=0.7

# 1. OpenAI Configuration
# Get your API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# 2. Google Gemini Configuration (Alternative)
# Get your API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Groq Ultra-Fast LLaMA Configuration (Alternative)
# Get your API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 4. Optional Custom or Local Endpoint (e.g. Ollama or OpenRouter)
# AI_ENDPOINT_URL=http://localhost:11434/v1/chat/completions

# Optional Medical Search / OAuth
GOOGLE_SEARCH_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
